<div class="max-w-2xl mx-auto">
  <h1 class="text-xl font-bold mb-6">New Admission</h1>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 text-sm"><%= error %></div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div id="receipt" class="bg-emerald-50 border border-emerald-200 rounded-xl p-6 mb-6">
      <h2 class="font-bold text-lg text-emerald-800 mb-2">✓ Member Registered</h2>
      <div class="space-y-1 text-sm text-emerald-700">
        <p>Name: <strong><%= success.name %></strong></p>
        <p>Amount: <strong>₹<%= Number(success.amount).toLocaleString() %></strong></p>
        <p>Receipt: <strong><%= success.receipt %></strong></p>
      </div>
      <button onclick="window.print()" class="mt-3 px-4 py-2 bg-emerald-600 text-white text-sm rounded-lg hover:bg-emerald-700">Print Receipt</button>
      <a href="/reception/new-admission" class="ml-2 px-4 py-2 border border-gray-300 text-sm rounded-lg hover:bg-gray-50 inline-block">New Admission</a>
    </div>
  <% } else { %>
  <form method="POST" action="/reception/new-admission" class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 space-y-5">
    <h2 class="font-semibold">Member Details</h2>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
        <input type="text" name="full_name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
        <input type="tel" name="phone" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none">
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input type="email" name="email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
        <input type="password" name="password" required minlength="6" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none">
      </div>
    </div>

    <hr class="border-gray-100">

    <h2 class="font-semibold">Membership Plan</h2>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Select Plan</label>
        <select name="plan_id" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none bg-white">
          <% plans.forEach(p => { %>
          <option value="<%= p.id %>" data-duration="<%= p.duration_months %>"><%= p.name %> — ₹<%= Number(p.price).toLocaleString() %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Amount Received (₹)</label>
        <input type="number" name="amount" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none">
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Payment Method</label>
      <select name="payment_method" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none bg-white">
        <option value="cash">Cash</option>
        <option value="card">Card</option>
        <option value="upi">UPI</option>
        <option value="bank_transfer">Bank Transfer</option>
      </select>
    </div>

    <button type="submit" class="w-full py-3 bg-brand-600 text-white rounded-lg font-medium hover:bg-brand-700 transition">
      Register Member & Collect Payment
    </button>
  </form>
  <% } %>
</div>

<div class="max-w-lg mx-auto text-center">
  <h1 class="text-xl font-bold mb-8">QR Check-in</h1>

  <div id="checkinResult">
    <% if (result) { %>
      <% if (result.error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl p-6 mb-6">
          <p class="text-lg">✕ <%= result.error %></p>
        </div>
      <% } else if (result.type === 'checkin') { %>
        <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-8 mb-6">
          <div class="text-5xl mb-4">✓</div>
          <p class="text-2xl font-bold text-emerald-800">Checked In</p>
          <p class="text-lg text-emerald-600 mt-1"><%= result.name %></p>
          <p class="text-sm text-emerald-500 mt-1"><%= result.time %></p>
        </div>
      <% } else if (result.type === 'checkout') { %>
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-8 mb-6">
          <div class="text-5xl mb-4">👋</div>
          <p class="text-2xl font-bold text-blue-800">Checked Out</p>
          <p class="text-lg text-blue-600 mt-1"><%= result.name %></p>
          <p class="text-sm text-blue-500 mt-1"><%= result.time %></p>
        </div>
      <% } %>
    <% } %>

    <form hx-post="/reception/attendance/check-in" hx-target="#checkinResult" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Scan QR or enter Member ID</label>
        <input type="text" name="member_id" placeholder="Member ID (UUID)" autofocus
          class="w-full px-4 py-3 text-center border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-500 outline-none text-lg">
      </div>
      <button type="submit" class="w-full py-3 bg-brand-600 text-white rounded-xl font-medium hover:bg-brand-700 transition">
        Check In / Out
      </button>
    </form>
  </div>
</div>

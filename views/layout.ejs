<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
  <meta name="theme-color" content="#0f172a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="GYM OS">
  <link rel="apple-touch-icon" href="/icon-192.svg">
  <link rel="manifest" href="/manifest.json">
  <title><%= title %> — GYM OS</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'] },
          screens: { 'xs': '480px' },
          colors: {
            brand: {
              50: '#eef2ff', 100: '#e0e7ff', 200: '#c7d2fe', 300: '#a5b4fc',
              400: '#818cf8', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca',
              800: '#3730a3', 900: '#312e81', 950: '#1e1b4b',
            },
            surface: { 50: '#f8fafc', 100: '#f1f5f9', 200: '#e2e8f0', 700: '#334155', 800: '#1e293b', 900: '#0f172a', 950: '#020617' },
          },
          animation: {
            'in': 'in 0.2s ease-out',
            'slide-up': 'slideUp 0.3s ease-out',
            'slide-right': 'slideRight 0.25s ease-out',
            'fade': 'fade 0.2s ease-out',
            'pulse-soft': 'pulseSoft 2s ease-in-out infinite',
          },
          keyframes: {
            in: { '0%': { opacity: '0', transform: 'translateY(4px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
            slideUp: { '0%': { opacity: '0', transform: 'translateY(12px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
            slideRight: { '0%': { transform: 'translateX(-100%)' }, '100%': { transform: 'translateX(0)' } },
            fade: { '0%': { opacity: '0' }, '100%': { opacity: '1' } },
            pulseSoft: { '0%, 100%': { opacity: '1' }, '50%': { opacity: '0.7' } },
          },
        },
      },
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    * { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; -webkit-tap-highlight-color: transparent; }
    html, body { overscroll-behavior: none; }
    .card { @apply bg-white rounded-2xl border border-gray-100 shadow-sm transition-all duration-200 hover:shadow-md; }
    .card-glass { @apply bg-white/80 backdrop-blur-xl rounded-2xl border border-white/20 shadow-lg; }
    .btn { @apply inline-flex items-center justify-center px-4 py-2.5 rounded-xl font-medium text-sm transition-all duration-200 active:scale-95 min-h-[44px]; }
    .btn-primary { @apply btn bg-brand-600 text-white hover:bg-brand-700 shadow-sm hover:shadow-md; }
    .btn-secondary { @apply btn bg-gray-100 text-gray-700 hover:bg-gray-200; }
    .btn-ghost { @apply btn text-gray-600 hover:bg-gray-100; }
    .input { @apply w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm transition-all duration-200 focus:bg-white focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 outline-none min-h-[44px]; }
    .badge { @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium; }
    .badge-success { @apply badge bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20; }
    .badge-warning { @apply badge bg-amber-50 text-amber-700 ring-1 ring-amber-600/20; }
    .badge-danger { @apply badge bg-red-50 text-red-700 ring-1 ring-red-600/20; }
    .badge-info { @apply badge bg-blue-50 text-blue-700 ring-1 ring-blue-600/20; }
    .badge-neutral { @apply badge bg-gray-100 text-gray-600 ring-1 ring-gray-500/20; }
    .stat-card { @apply card p-5; }
    .stat-value { @apply text-2xl font-bold tracking-tight; }
    .stat-label { @apply text-xs font-medium text-gray-500 uppercase tracking-wider; }
    .table-row { @apply transition-colors duration-150 hover:bg-gray-50/80; }
    .shimmer { background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
    @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    /* Mobile sidebar overlay */
    .sidebar { display: none; }
    .sidebar.open { display: flex !important; position: fixed !important; z-index: 50 !important; inset: 0 !important; }
    .sidebar.open::before { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.5); z-index: -1; }
    .sidebar.open > nav { animation: slideRight 0.25s ease-out; width: 280px; max-width: 85vw; }

    /* Bottom nav */
    .bottom-nav { display: none; }
    @media (max-width: 767px) {
      .bottom-nav.member { display: flex; }
      .sidebar { display: none; }
      body { padding-bottom: env(safe-area-inset-bottom, 0px); }
      .pb-safe { padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px)); }
      main { padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px)); }
    }
    @media (min-width: 768px) {
      .sidebar { display: flex !important; position: static !important; }
      .hamburger { display: none; }
      .bottom-nav { display: none !important; }
    }

    /* Safe areas for notched phones */
    @supports (padding: env(safe-area-inset-top)) {
      .pt-safe { padding-top: env(safe-area-inset-top); }
      .pl-safe { padding-left: env(safe-area-inset-left); }
      .pr-safe { padding-right: env(safe-area-inset-right); }
    }

    /* Pull-to-refresh indicator */
    .ptr-indicator { @apply flex items-center justify-center text-xs text-gray-400 py-2; }
  </style>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏋️</text></svg>">
</head>
<body class="h-full bg-surface-50 text-surface-800 antialiased font-sans">

  <% if (user) { %>
  <div class="flex h-full">
    <!-- Mobile sidebar overlay -->
    <div class="sidebar fixed inset-0 z-50 hidden" id="sidebar-overlay" onclick="document.getElementById('sidebar-overlay').classList.remove('open')">
      <nav onclick="event.stopPropagation()" class="sidebar-inner w-64 bg-surface-900 text-white h-full overflow-auto shrink-0 flex flex-col">
        <div class="p-5 border-b border-white/5 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-brand-500 flex items-center justify-center text-xs font-bold shadow-lg shadow-brand-500/25">G</div>
            <div>
              <h1 class="text-sm font-bold tracking-tight">GYM OS</h1>
              <p class="text-[10px] text-gray-400 uppercase tracking-wider"><%= user.role %></p>
            </div>
          </div>
          <button onclick="document.getElementById('sidebar-overlay').classList.remove('open')" class="p-1.5 rounded-lg hover:bg-white/10 text-gray-400 md:hidden">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="flex-1 overflow-auto py-3 px-3 space-y-0.5">
          <%- include('partials/nav_links') %>
        </div>
        <div class="p-4 border-t border-white/5">
          <a href="/auth/logout" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Logout
          </a>
        </div>
      </nav>
    </div>

    <!-- Desktop sidebar -->
    <aside class="hidden md:flex w-64 bg-surface-900 text-white flex-col h-full shrink-0">
      <div class="p-5 border-b border-white/5">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-brand-500 flex items-center justify-center text-sm font-bold shadow-lg shadow-brand-500/25">G</div>
          <div>
            <h1 class="text-lg font-bold tracking-tight">GYM OS</h1>
            <p class="text-[11px] text-gray-400 uppercase tracking-wider"><%= user.role %></p>
          </div>
        </div>
      </div>
      <div class="flex-1 overflow-auto py-3 px-3 space-y-0.5">
        <%- include('partials/nav_links') %>
      </div>
      <div class="p-4 border-t border-white/5">
        <a href="/auth/logout" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          Logout
        </a>
      </div>
    </aside>

    <main class="flex-1 overflow-auto bg-surface-50 flex flex-col">
      <!-- Header with hamburger for mobile -->
      <header class="h-14 bg-white/80 backdrop-blur-xl border-b border-gray-100 flex items-center justify-between px-3 md:px-6 shrink-0 sticky top-0 z-10 pt-safe">
        <div class="flex items-center gap-3">
          <button class="hamburger p-2 -ml-1 rounded-lg hover:bg-gray-100 transition-colors" onclick="document.getElementById('sidebar-overlay').classList.add('open')" aria-label="Menu">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
          </button>
          <h2 class="text-sm font-semibold text-surface-700 truncate"><%= title %></h2>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-[10px] text-gray-400 hidden sm:block"><%= new Date().toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' }) %></span>
          <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-xs font-bold shadow-lg shadow-brand-500/25 ring-2 ring-white shrink-0">
            <%= user.full_name ? user.full_name.charAt(0).toUpperCase() : '?' %>
          </div>
        </div>
      </header>

      <!-- Content -->
      <div class="flex-1 p-3 md:p-6 animate-in pb-safe">
        <%- include(body) %>
      </div>

      <!-- Mobile bottom nav (member only) -->
      <% if (user.role === 'member') { %>
      <nav class="bottom-nav member fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-xl border-t border-gray-100 flex items-center justify-around z-30 safe-bottom">
        <a href="/member" class="flex flex-col items-center gap-0.5 py-2 px-3 <%= currentPath === '/member' ? 'text-brand-600' : 'text-gray-400' %> transition-colors min-w-[64px]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/></svg>
          <span class="text-[10px] font-medium">Home</span>
        </a>
        <a href="/member/qr" class="flex flex-col items-center gap-0.5 py-2 px-3 <%= currentPath === '/member/qr' ? 'text-brand-600' : 'text-gray-400' %> transition-colors min-w-[64px]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
          <span class="text-[10px] font-medium">Check-in</span>
        </a>
        <a href="/member/workout" class="flex flex-col items-center gap-0.5 py-2 px-3 <%= currentPath === '/member/workout' ? 'text-brand-600' : 'text-gray-400' %> transition-colors min-w-[64px]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <span class="text-[10px] font-medium">Workout</span>
        </a>
        <a href="/member/bookings" class="flex flex-col items-center gap-0.5 py-2 px-3 <%= currentPath === '/member/bookings' ? 'text-brand-600' : 'text-gray-400' %> transition-colors min-w-[64px]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span class="text-[10px] font-medium">Bookings</span>
        </a>
        <a href="/member/notifications" class="flex flex-col items-center gap-0.5 py-2 px-3 <%= currentPath === '/member/notifications' ? 'text-brand-600' : 'text-gray-400' %> transition-colors min-w-[64px]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
          <span class="text-[10px] font-medium">Alerts</span>
        </a>
      </nav>
      <% } %>
    </main>
  </div>

  <% } else { %>
  <main class="h-full">
    <%- include(body) %>
  </main>
  <script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
  }
  </script>
  <% } %>

  <script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
  }

  document.getElementById('sidebar-overlay')?.addEventListener('click', function(e) {
    if (e.target === this) this.classList.remove('open');
  });
  </script>

</body>
</html>

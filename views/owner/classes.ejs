<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-bold">Class Management</h1>
  <div class="flex gap-2">
    <button onclick="document.getElementById('classModal').classList.remove('hidden')"
      class="px-4 py-2 bg-gray-900 text-white text-sm rounded-lg hover:bg-gray-800">Add Class Type</button>
    <button onclick="document.getElementById('scheduleModal').classList.remove('hidden')"
      class="px-4 py-2 bg-brand-600 text-white text-sm rounded-lg hover:bg-brand-700">Schedule Class</button>
  </div>
</div>

<!-- Class Types -->
<div class="mb-8">
  <h2 class="font-semibold mb-3">Class Types</h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <% classes.forEach(c => { %>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4">
      <p class="font-medium"><%= c.name %></p>
      <p class="text-xs text-gray-400 capitalize"><%= c.category %></p>
      <p class="text-xs text-gray-500 mt-1"><%= c.max_capacity %> capacity · <%= c.default_duration_minutes %>min</p>
    </div>
    <% }) %>
    <% if (classes.length === 0) { %>
    <p class="text-gray-400 text-sm col-span-4">No class types defined yet.</p>
    <% } %>
  </div>
</div>

<!-- Upcoming Schedule -->
<div>
  <h2 class="font-semibold mb-3">Upcoming Classes</h2>
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-gray-600">
        <tr>
          <th class="text-left px-4 py-3 font-medium">Class</th>
          <th class="text-left px-4 py-3 font-medium">Date</th>
          <th class="text-left px-4 py-3 font-medium">Time</th>
          <th class="text-left px-4 py-3 font-medium">Trainer</th>
          <th class="text-left px-4 py-3 font-medium">Booked</th>
          <th class="text-left px-4 py-3 font-medium"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% schedules.forEach(s => { %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3 font-medium"><%= s.classes?.name %></td>
          <td class="px-4 py-3 text-gray-500"><%= new Date(s.schedule_date + 'T00:00:00').toLocaleDateString('en-IN', { weekday: 'short', month: 'short', day: 'numeric' }) %></td>
          <td class="px-4 py-3 text-gray-500"><%= s.start_time?.substring(0, 5) %></td>
          <td class="px-4 py-3 text-gray-500"><%= s.trainers?.profiles?.full_name || 'Unassigned' %></td>
          <td class="px-4 py-3"><%= s.booked_count || 0 %>/<%= s.capacity %></td>
          <td class="px-4 py-3">
            <a href="/owner/classes/<%= s.id %>/bookings" class="text-brand-600 hover:underline text-xs">Bookings →</a>
          </td>
        </tr>
        <% }) %>
        <% if (schedules.length === 0) { %>
        <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">No classes scheduled.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Add Class Type Modal -->
<div id="classModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
  <div class="bg-white rounded-xl p-6 w-full max-w-md shadow-xl">
    <h3 class="font-semibold text-lg mb-4">Add Class Type</h3>
    <form method="POST" action="/owner/classes">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Class Name</label>
          <input type="text" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Morning Yoga">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
          <select name="category" class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-white">
            <option value="yoga">Yoga</option>
            <option value="hiit">HIIT</option>
            <option value="strength">Strength</option>
            <option value="cardio">Cardio</option>
            <option value="dance">Dance</option>
            <option value="cycling">Cycling</option>
            <option value="pilates">Pilates</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Max Capacity</label>
            <input type="number" name="max_capacity" class="w-full px-4 py-2 border border-gray-300 rounded-lg" value="20">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Duration (min)</label>
            <input type="number" name="default_duration_minutes" class="w-full px-4 py-2 border border-gray-300 rounded-lg" value="60">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <input type="text" name="description" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>
      </div>
      <div class="flex gap-2 mt-6">
        <button type="button" onclick="document.getElementById('classModal').classList.add('hidden')"
          class="flex-1 px-4 py-2 border border-gray-300 rounded-lg">Cancel</button>
        <button type="submit" class="flex-1 px-4 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-800">Create Class</button>
      </div>
    </form>
  </div>
</div>

<!-- Schedule Class Modal -->
<div id="scheduleModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
  <div class="bg-white rounded-xl p-6 w-full max-w-md shadow-xl">
    <h3 class="font-semibold text-lg mb-4">Schedule a Class</h3>
    <form method="POST" action="/owner/classes/schedule">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Class Type</label>
          <select name="class_id" required class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-white">
            <option value="">Select class...</option>
            <% classes.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Trainer</label>
          <select name="trainer_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-white">
            <option value="">Unassigned</option>
            <% trainers.forEach(t => { %><option value="<%= t.id %>"><%= t.profiles?.full_name %></option><% }) %>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
            <input type="date" name="schedule_date" required class="w-full px-4 py-2 border border-gray-300 rounded-lg">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Start Time</label>
            <input type="time" name="start_time" required class="w-full px-4 py-2 border border-gray-300 rounded-lg">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Capacity</label>
            <input type="number" name="capacity" class="w-full px-4 py-2 border border-gray-300 rounded-lg" value="20">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Duration (min)</label>
            <input type="number" name="duration" class="w-full px-4 py-2 border border-gray-300 rounded-lg" value="60">
          </div>
        </div>
      </div>
      <div class="flex gap-2 mt-6">
        <button type="button" onclick="document.getElementById('scheduleModal').classList.add('hidden')"
          class="flex-1 px-4 py-2 border border-gray-300 rounded-lg">Cancel</button>
        <button type="submit" class="flex-1 px-4 py-2 bg-brand-600 text-white rounded-lg hover:bg-brand-700">Schedule</button>
      </div>
    </form>
  </div>
</div>

<% const s = stats || {}; %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold">Overview</h2>
      <p class="text-sm text-gray-500 mt-0.5">Real-time gym stats</p>
    </div>
    <div class="flex items-center gap-2 text-[11px] text-gray-400">
      <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse-soft"></div>
      Live
    </div>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="stat-card group cursor-default">
      <div class="flex items-center justify-between mb-2">
        <span class="stat-label">Active Members</span>
        <div class="w-8 h-8 rounded-xl bg-brand-50 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
      </div>
      <div class="stat-value"><%= s.activeMembers || 0 %></div>
      <div class="text-xs text-gray-400 mt-1">total members</div>
    </div>

    <div class="stat-card group cursor-default">
      <div class="flex items-center justify-between mb-2">
        <span class="stat-label">Revenue (Month)</span>
        <div class="w-8 h-8 rounded-xl bg-emerald-50 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <div class="stat-value">₹<%= (s.monthTotal || 0).toLocaleString('en-IN') %></div>
      <div class="text-xs text-gray-400 mt-1">Today: ₹<%= (s.todayTotal || 0).toLocaleString('en-IN') %></div>
    </div>

    <div class="stat-card group cursor-default">
      <div class="flex items-center justify-between mb-2">
        <span class="stat-label">Inside Now</span>
        <div class="w-8 h-8 rounded-xl bg-blue-50 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
        </div>
      </div>
      <div class="stat-value"><%= s.membersInside || 0 %></div>
      <div class="text-xs text-gray-400 mt-1"><%= s.capacityPct || 0 %>% capacity</div>
    </div>

    <div class="stat-card group cursor-default">
      <div class="flex items-center justify-between mb-2">
        <span class="stat-label">Expiring Soon</span>
        <div class="w-8 h-8 rounded-xl bg-amber-50 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <div class="stat-value"><%= s.renewalsDue || 0 %></div>
      <div class="text-xs text-amber-600 font-medium mt-1">Within 7 days</div>
    </div>
  </div>

  <div class="grid lg:grid-cols-3 gap-4">
    <div class="card p-5">
      <div class="w-9 h-9 rounded-xl bg-purple-50 flex items-center justify-center mb-3">
        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
      </div>
      <h3 class="text-sm font-semibold">Peak Hour</h3>
      <p class="text-2xl font-bold mt-1"><%= s.peakDisplay || '—' %></p>
      <span class="text-xs text-gray-400">Busiest time today</span>
    </div>

    <div class="card p-5">
      <div class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center mb-3">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <h3 class="text-sm font-semibold">Trainers</h3>
      <p class="text-2xl font-bold mt-1"><%= s.trainerCount || 0 %></p>
      <span class="text-xs text-gray-400">Active</span>
    </div>

    <div class="card p-5">
      <div class="w-9 h-9 rounded-xl bg-red-50 flex items-center justify-center mb-3">
        <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
      </div>
      <h3 class="text-sm font-semibold">At Risk</h3>
      <p class="text-2xl font-bold mt-1"><%= s.expiringMembers || 0 %></p>
      <span class="text-xs text-red-600 font-medium">Expiring in 3 days</span>
    </div>
  </div>

  <% if (s.suggestion) { %>
  <div class="card p-5 border-l-4 <%= s.suggestion.type === 'capacity' ? 'border-l-red-500' : s.suggestion.type === 'opportunity' ? 'border-l-emerald-500' : 'border-l-brand-500' %>">
    <div class="flex items-start gap-3">
      <div class="w-8 h-8 rounded-lg <%= s.suggestion.type === 'capacity' ? 'bg-red-50 text-red-600' : 'bg-emerald-50 text-emerald-600' %> flex items-center justify-center shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
      </div>
      <div>
        <h3 class="text-sm font-semibold"><%= s.suggestion.title %></h3>
        <p class="text-xs text-gray-500 mt-0.5"><%= s.suggestion.description %></p>
      </div>
    </div>
  </div>
  <% } %>

  <div class="grid gap-4 sm:grid-cols-2">
    <a href="/owner/members" class="card p-4 hover:border-brand-200 hover:shadow-md transition-all group flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-brand-50 flex items-center justify-center group-hover:scale-110 transition-transform">
          <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
        </div>
        <span class="text-sm font-medium">Add Member</span>
      </div>
      <svg class="w-4 h-4 text-gray-300 group-hover:text-brand-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg>
    </a>
    <a href="/owner/reports" class="card p-4 hover:border-brand-200 hover:shadow-md transition-all group flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-purple-50 flex items-center justify-center group-hover:scale-110 transition-transform">
          <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
        <span class="text-sm font-medium">View Reports</span>
      </div>
      <svg class="w-4 h-4 text-gray-300 group-hover:text-brand-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>
</div>

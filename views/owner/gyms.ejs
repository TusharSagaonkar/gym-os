<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-bold">Branches</h1>
  <button onclick="document.getElementById('gymModal').classList.remove('hidden')"
    class="px-4 py-2 bg-brand-600 text-white text-sm rounded-lg hover:bg-brand-700">Add Branch</button>
</div>

<!-- Active Branch Badge -->
<% if (activeGym) { %>
<div class="bg-brand-50 border border-brand-200 rounded-xl p-4 mb-6">
  <p class="text-sm text-brand-700">Active Branch: <strong><%= activeGym.name %></strong></p>
  <p class="text-xs text-brand-500 mt-0.5"><%= activeGym.address || '' %> · Capacity: <%= activeGym.capacity || 100 %></p>
</div>
<% } %>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  <% gyms.forEach(g => { %>
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 <%= activeGym && g.id === activeGym.id ? 'ring-2 ring-brand-500' : '' %>">
    <div class="flex items-start justify-between mb-3">
      <h3 class="font-semibold text-lg"><%= g.name %></h3>
      <% if (activeGym && g.id === activeGym.id) { %>
      <span class="inline-flex px-2 py-0.5 text-xs rounded-full bg-brand-100 text-brand-700 font-medium">Active</span>
      <% } %>
    </div>
    <p class="text-sm text-gray-500"><%= g.address || 'No address set' %></p>
    <div class="flex gap-2 text-xs text-gray-400 mt-3">
      <span>Capacity: <%= g.capacity || 100 %></span>
      <span>·</span>
      <span><%= g.open_time?.substring(0,5) || '05:00' %> - <%= g.close_time?.substring(0,5) || '23:00' %></span>
    </div>
    <% if (!activeGym || g.id !== activeGym.id) { %>
    <a href="/owner/gyms/<%= g.id %>/switch" class="mt-3 inline-block px-3 py-1.5 text-sm bg-brand-600 text-white rounded-lg hover:bg-brand-700">
      Switch to Branch
    </a>
    <% } %>
  </div>
  <% }) %>
</div>

<% if (gyms.length === 0) { %>
<div class="text-center py-12">
  <p class="text-gray-400 text-lg">No branches set up.</p>
  <p class="text-sm text-gray-400 mt-1">Create your first gym branch to get started.</p>
</div>
<% } %>

<!-- Add Gym Modal -->
<div id="gymModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
  <div class="bg-white rounded-xl p-6 w-full max-w-md shadow-xl">
    <h3 class="font-semibold text-lg mb-4">Add Branch</h3>
    <form method="POST" action="/owner/gyms">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Branch Name</label>
          <input type="text" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Downtown Gym">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
          <input type="text" name="address" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Capacity</label>
            <input type="number" name="capacity" class="w-full px-4 py-2 border border-gray-300 rounded-lg" value="100">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Hours</label>
            <div class="flex gap-1">
              <input type="time" name="open_time" class="flex-1 px-2 py-2 border border-gray-300 rounded-lg text-sm" value="05:00">
              <span class="text-gray-400 self-center">-</span>
              <input type="time" name="close_time" class="flex-1 px-2 py-2 border border-gray-300 rounded-lg text-sm" value="23:00">
            </div>
          </div>
        </div>
      </div>
      <div class="flex gap-2 mt-6">
        <button type="button" onclick="document.getElementById('gymModal').classList.add('hidden')"
          class="flex-1 px-4 py-2 border border-gray-300 rounded-lg">Cancel</button>
        <button type="submit" class="flex-1 px-4 py-2 bg-brand-600 text-white rounded-lg hover:bg-brand-700">Create Branch</button>
      </div>
    </form>
  </div>
</div>

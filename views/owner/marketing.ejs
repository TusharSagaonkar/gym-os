<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-bold">Marketing Automation</h1>
  <button onclick="document.getElementById('ruleModal').classList.remove('hidden')"
    class="px-4 py-2 bg-brand-600 text-white text-sm rounded-lg hover:bg-brand-700">Add Rule</button>
</div>

<p class="text-sm text-gray-500 mb-6">Automatically send notifications to members when conditions are met. No manual follow-ups needed.</p>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <% rules.forEach(rule => { %>
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 <%= !rule.is_active ? 'opacity-60' : '' %>">
    <div class="flex items-start justify-between mb-3">
      <h3 class="font-semibold"><%= rule.name %></h3>
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" <%= rule.is_active ? 'checked' : '' %>
          hx-post="/analytics/marketing/rule/<%= rule.id %>/toggle" hx-swap="none" class="sr-only peer">
        <div class="w-9 h-5 bg-gray-200 peer-focus:ring-2 peer-focus:ring-brand-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-brand-600 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all"></div>
      </label>
    </div>
    <% if (rule.description) { %><p class="text-xs text-gray-400 mb-2"><%= rule.description %></p><% } %>
    <div class="flex gap-2 mb-3">
      <span class="inline-flex px-2 py-0.5 text-xs rounded bg-blue-100 text-blue-700">
        <%= rule.trigger_type.replace(/_/g, ' ') %>
      </span>
      <span class="inline-flex px-2 py-0.5 text-xs rounded bg-gray-100 text-gray-600">
        <%= rule.action_type %>
      </span>
    </div>
    <p class="text-sm text-gray-600 bg-gray-50 rounded-lg p-3"><%= rule.action_template %></p>
    <div class="mt-3 flex gap-2">
      <button hx-post="/analytics/marketing/trigger/<%= rule.id %>" hx-swap="none"
        class="text-xs px-3 py-1.5 bg-brand-600 text-white rounded hover:bg-brand-700">
        Run Now
      </button>
    </div>
  </div>
  <% }) %>
</div>

<% if (rules.length === 0) { %>
<div class="text-center py-12">
  <p class="text-gray-400 text-lg">No automation rules yet.</p>
</div>
<% } %>

<!-- Add Rule Modal -->
<div id="ruleModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
  <div class="bg-white rounded-xl p-6 w-full max-w-lg shadow-xl">
    <h3 class="font-semibold text-lg mb-4">Add Automation Rule</h3>
    <form method="POST" action="/analytics/marketing/rule">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Rule Name</label>
          <input type="text" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Expiring Membership Alert">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <input type="text" name="description" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Trigger</label>
            <select name="trigger_type" required class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-white">
              <option value="membership_expiring">Membership Expiring</option>
              <option value="inactive_7_days">Inactive 7 Days</option>
              <option value="inactive_14_days">Inactive 14 Days</option>
              <option value="renewal_overdue">Renewal Overdue</option>
              <option value="first_visit">First Visit</option>
              <option value="payment_due">Payment Due</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Action</label>
            <select name="action_type" class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-white">
              <option value="notification">Send Notification</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Message Template</label>
          <textarea name="action_template" required rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm"
            placeholder="Hi, your membership expires in 7 days. Renew now to continue..."></textarea>
        </div>
      </div>
      <div class="flex gap-2 mt-6">
        <button type="button" onclick="document.getElementById('ruleModal').classList.add('hidden')"
          class="flex-1 px-4 py-2 border border-gray-300 rounded-lg">Cancel</button>
        <button type="submit" class="flex-1 px-4 py-2 bg-brand-600 text-white rounded-lg hover:bg-brand-700">Create Rule</button>
      </div>
    </form>
  </div>
</div>

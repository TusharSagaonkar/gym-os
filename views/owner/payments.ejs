<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold">Payments</h2>
      <p class="text-sm text-gray-500 mt-0.5">Track revenue and transactions</p>
    </div>
    <select name="filter" hx-get="/owner/payments" hx-target="#paymentsList" hx-trigger="change"
      class="input min-w-[160px]">
      <option value="today" <%= filter === 'today' ? 'selected' : '' %>>Today</option>
      <option value="week" <%= filter === 'week' ? 'selected' : '' %>>This Week</option>
      <option value="month" <%= filter === 'month' ? 'selected' : '' %>>This Month</option>
    </select>
  </div>

  <div id="paymentsList" class="space-y-6">
    <div class="stat-card">
      <span class="stat-label">Total Revenue</span>
      <div class="stat-value mt-2">₹<%= (total || 0).toLocaleString('en-IN') %></div>
    </div>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-[11px] text-gray-400 uppercase tracking-wider border-b border-gray-50">
              <th class="text-left font-medium px-4 py-3">Member</th>
              <th class="text-left font-medium px-4 py-3">Amount</th>
              <th class="text-left font-medium px-4 py-3 hidden sm:table-cell">Method</th>
              <th class="text-left font-medium px-4 py-3 hidden md:table-cell">Receipt</th>
              <th class="text-right font-medium px-4 py-3">Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            <% if (payments && payments.length) { %>
              <% payments.forEach(p => { %>
              <tr class="table-row">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center text-white text-[10px] font-bold shrink-0">
                      <%= (p.profiles?.full_name || '?').charAt(0).toUpperCase() %>
                    </div>
                    <span class="font-medium"><%= p.profiles?.full_name || 'Unknown' %></span>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <span class="font-semibold text-emerald-700">₹<%= Number(p.amount).toLocaleString('en-IN') %></span>
                </td>
                <td class="px-4 py-3 text-gray-500 capitalize hidden sm:table-cell"><%= p.payment_method %></td>
                <td class="px-4 py-3 text-gray-400 text-xs hidden md:table-cell"><%= p.receipt_number || '—' %></td>
                <td class="px-4 py-3 text-gray-500 text-right"><%= new Date(p.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" class="px-4 py-16 text-center">
                <div class="w-12 h-12 rounded-2xl bg-gray-100 flex items-center justify-center mx-auto mb-3">
                  <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <p class="text-sm text-gray-500">No payments found</p>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

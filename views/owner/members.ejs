<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-bold">Members</h1>
  <div class="flex gap-3">
    <select name="status" hx-get="/owner/members" hx-target="#membersList" hx-trigger="change" name="status"
      class="px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white">
      <option value="all" <%= status === 'all' ? 'selected' : '' %>>All Status</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="expired" <%= status === 'expired' ? 'selected' : '' %>>Expired</option>
      <option value="frozen" <%= status === 'frozen' ? 'selected' : '' %>>Frozen</option>
    </select>
    <input type="text" name="search" placeholder="Search member..." value="<%= search %>"
      hx-get="/owner/members" hx-trigger="keyup changed delay:300ms" hx-target="#membersList"
      class="px-3 py-2 text-sm border border-gray-300 rounded-lg w-64">
  </div>
</div>

<div id="membersList">
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-gray-600">
        <tr>
          <th class="text-left px-4 py-3 font-medium">Name</th>
          <th class="text-left px-4 py-3 font-medium">Phone</th>
          <th class="text-left px-4 py-3 font-medium">Plan</th>
          <th class="text-left px-4 py-3 font-medium">Status</th>
          <th class="text-left px-4 py-3 font-medium">Expires</th>
          <th class="text-left px-4 py-3 font-medium"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% members.forEach(m => { %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3 font-medium"><%= m.full_name %></td>
          <td class="px-4 py-3 text-gray-500"><%= m.phone || '—' %></td>
          <td class="px-4 py-3"><%= m.memberships?.plan_id ? 'Active Plan' : '—' %></td>
          <td class="px-4 py-3">
            <% const s = m.memberships?.status; %>
            <span class="inline-flex px-2 py-0.5 text-xs rounded-full font-medium
              <%= s === 'active' ? 'bg-emerald-100 text-emerald-700' : s === 'expired' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700' %>">
              <%= s %>
            </span>
          </td>
          <td class="px-4 py-3 text-gray-500"><%= m.memberships?.end_date ? new Date(m.memberships.end_date).toLocaleDateString('en-IN') : '—' %></td>
          <td class="px-4 py-3">
            <a href="/owner/members/<%= m.id %>" class="text-brand-600 hover:underline text-xs">View →</a>
          </td>
        </tr>
        <% }) %>
        <% if (members.length === 0) { %>
        <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">No members found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-bold">IoT Sensors</h1>
  <button onclick="document.getElementById('sensorModal').classList.remove('hidden')"
    class="px-4 py-2 bg-brand-600 text-white text-sm rounded-lg hover:bg-brand-700">Add Sensor</button>
</div>

<!-- Sensor Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
  <% sensors.forEach(s => { %>
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 <%= !s.is_active ? 'opacity-60' : '' %>">
    <div class="flex items-start justify-between mb-3">
      <div>
        <h3 class="font-semibold"><%= s.name %></h3>
        <p class="text-xs text-gray-400 capitalize"><%= s.sensor_type %> · <%= s.location || 'Unnamed' %></p>
      </div>
      <span class="inline-flex px-2 py-0.5 text-xs rounded-full <%= s.is_active ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
        <%= s.is_active ? 'Active' : 'Offline' %>
      </span>
    </div>
    <% const latest = readings?.filter(r => r.sensor_id === s.id)[0]; %>
    <p class="text-3xl font-bold"><%= latest ? latest.value : '—' %></p>
    <p class="text-xs text-gray-400"><%= latest ? new Date(latest.recorded_at).toLocaleString('en-IN') : 'No data' %></p>
    <details class="mt-3">
      <summary class="text-xs text-gray-400 cursor-pointer hover:text-gray-600">API Key</summary>
      <code class="text-xs text-gray-500 break-all"><%= s.api_key %></code>
    </details>
    <p class="text-xs text-gray-300 mt-1">POST /integrations/sensors/reading</p>
  </div>
  <% }) %>
</div>

<% if (sensors.length === 0) { %>
<div class="text-center py-12 mb-8">
  <p class="text-gray-400 text-lg">No sensors registered.</p>
  <p class="text-sm text-gray-400 mt-1">Add occupancy sensors to track real-time member counts.</p>
</div>
<% } %>

<!-- Recent Readings -->
<div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
  <h2 class="font-semibold mb-4">Recent Readings</h2>
  <% if (readings.length > 0) { %>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-gray-600"><tr>
        <th class="text-left py-2">Sensor</th>
        <th class="text-left py-2">Value</th>
        <th class="text-left py-2">Time</th>
      </tr></thead>
      <tbody class="divide-y divide-gray-100">
        <% readings.slice(0, 20).forEach(r => { %>
        <tr>
          <td class="py-2"><%= r.iot_sensors?.name || 'Unknown' %></td>
          <td class="py-2 font-medium"><%= r.value %> <%= r.unit %></td>
          <td class="py-2 text-gray-500"><%= new Date(r.recorded_at).toLocaleString('en-IN') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="text-gray-400 text-sm">No readings yet. Sensors will appear here once data flows in.</p>
  <% } %>
</div>

<!-- Add Sensor Modal -->
<div id="sensorModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
  <div class="bg-white rounded-xl p-6 w-full max-w-md shadow-xl">
    <h3 class="font-semibold text-lg mb-4">Register Sensor</h3>
    <form method="POST" action="/integrations/sensors/device">
      <div class="space-y-4">
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
          <input type="text" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Main Floor Occupancy"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
          <select name="sensor_type" class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-white">
            <option value="occupancy">Occupancy</option>
            <option value="temperature">Temperature</option>
            <option value="humidity">Humidity</option>
            <option value="noise">Noise</option>
            <option value="air_quality">Air Quality</option>
            <option value="energy">Energy</option>
          </select></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
          <input type="text" name="location" class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Main entrance"></div>
      </div>
      <div class="flex gap-2 mt-6">
        <button type="button" onclick="document.getElementById('sensorModal').classList.add('hidden')" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg">Cancel</button>
        <button type="submit" class="flex-1 px-4 py-2 bg-brand-600 text-white rounded-lg hover:bg-brand-700">Register</button>
      </div>
    </form>
  </div>
</div>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold">Attendance</h2>
      <p class="text-sm text-gray-500 mt-0.5">Track member check-ins</p>
    </div>
    <form hx-get="/owner/attendance" hx-target="#attendanceLog" hx-trigger="change">
      <input type="date" name="date" value="<%= date %>"
        class="input min-w-[160px]">
    </form>
  </div>

  <div id="attendanceLog" class="space-y-6">
    <div class="grid grid-cols-2 gap-4">
      <div class="stat-card">
        <span class="stat-label">Total Visits</span>
        <div class="stat-value mt-2"><%= logs ? logs.length : 0 %></div>
        <div class="text-xs text-gray-400 mt-1"><%= date %></div>
      </div>
      <div class="stat-card">
        <span class="stat-label">Inside Now</span>
        <div class="stat-value mt-2 text-emerald-600"><%= insideCount || 0 %></div>
        <div class="text-xs text-gray-400 mt-1">currently in gym</div>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-[11px] text-gray-400 uppercase tracking-wider border-b border-gray-50">
              <th class="text-left font-medium px-4 py-3">Member</th>
              <th class="text-left font-medium px-4 py-3">Check In</th>
              <th class="text-left font-medium px-4 py-3">Check Out</th>
              <th class="text-left font-medium px-4 py-3">Duration</th>
              <th class="text-right font-medium px-4 py-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            <% if (logs && logs.length) { %>
              <% logs.forEach(l => { %>
              <tr class="table-row">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-[10px] font-bold shrink-0">
                      <%= (l.profiles?.full_name || '?').charAt(0).toUpperCase() %>
                    </div>
                    <span class="font-medium"><%= l.profiles?.full_name || 'Unknown' %></span>
                  </div>
                </td>
                <td class="px-4 py-3 text-gray-500"><%= new Date(l.check_in).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></td>
                <td class="px-4 py-3 text-gray-500"><%= l.check_out ? new Date(l.check_out).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) : '—' %></td>
                <td class="px-4 py-3 text-gray-500"><%= l.duration_minutes ? `${Math.round(l.duration_minutes)} min` : '—' %></td>
                <td class="px-4 py-3 text-right">
                  <span class="badge <%= l.check_out ? 'badge-neutral' : 'badge-success' %>">
                    <%= l.check_out ? 'Left' : 'Inside' %>
                  </span>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" class="px-4 py-16 text-center">
                <div class="w-12 h-12 rounded-2xl bg-gray-100 flex items-center justify-center mx-auto mb-3">
                  <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                </div>
                <p class="text-sm text-gray-500">No attendance records</p>
                <p class="text-xs text-gray-400 mt-0.5">for <%= date %></p>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

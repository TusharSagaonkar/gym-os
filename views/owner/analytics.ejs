<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-bold">Occupancy Analytics</h1>
  <div class="flex gap-2">
    <a href="/analytics/occupancy?days=7" class="px-3 py-1.5 text-sm rounded-lg <%= days === 7 ? 'bg-brand-600 text-white' : 'border border-gray-300' %>">7 days</a>
    <a href="/analytics/occupancy?days=14" class="px-3 py-1.5 text-sm rounded-lg <%= days === 14 ? 'bg-brand-600 text-white' : 'border border-gray-300' %>">14 days</a>
    <a href="/analytics/occupancy?days=30" class="px-3 py-1.5 text-sm rounded-lg <%= days === 30 ? 'bg-brand-600 text-white' : 'border border-gray-300' %>">30 days</a>
  </div>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
    <p class="text-xs text-gray-500">Total Check-ins</p>
    <p class="text-2xl font-bold mt-1"><%= totalRecords %></p>
  </div>
  <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
    <p class="text-xs text-gray-500">Avg Duration</p>
    <p class="text-2xl font-bold mt-1"><%= avgDuration %> min</p>
  </div>
  <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
    <p class="text-xs text-gray-500">Busiest</p>
    <p class="text-2xl font-bold mt-1"><%= dayLabels[busiestDay] %> <%= busiestHour %>:00</p>
  </div>
  <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
    <p class="text-xs text-gray-500">Quietest Period</p>
    <p class="text-2xl font-bold mt-1"><%= quietestStart %>:00–<%= quietestStart + 2 %>:00</p>
    <p class="text-xs text-gray-400">~<%= quietestAvg %> visits avg</p>
  </div>
</div>

<!-- Heatmap -->
<div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 mb-6">
  <h2 class="font-semibold mb-4">Hourly Heatmap (<%= days %> days)</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-xs">
      <thead>
        <tr>
          <th class="text-left py-1 px-2 text-gray-500 font-medium w-16">Hour</th>
          <% dayLabels.forEach(d => { %><th class="text-center py-1 px-1 text-gray-500 font-medium"><%= d %></th><% }) %>
        </tr>
      </thead>
      <tbody>
        <% for (let h = 5; h <= 23; h++) { %>
        <tr>
          <td class="py-0.5 px-2 text-gray-400 font-medium"><%= h %>:00</td>
          <% for (let d = 0; d < 7; d++) {
            const count = heatmap[d][h];
            const intensity = maxCount > 0 ? count / maxCount : 0;
            const bg = intensity > 0.8 ? 'bg-brand-600 text-white' : intensity > 0.5 ? 'bg-brand-300 text-brand-900' : intensity > 0.2 ? 'bg-brand-100 text-brand-700' : intensity > 0 ? 'bg-gray-100 text-gray-500' : 'bg-gray-50 text-gray-300';
          %>
          <td class="text-center py-0.5 px-1">
            <span class="inline-block w-full rounded py-1 <%= bg %>"><%= count || '–' %></span>
          </td>
          <% } %>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div class="flex items-center gap-3 mt-4 text-xs text-gray-400">
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-gray-50"></span> Empty</span>
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-brand-600"></span> Busy (<%= maxCount %>)</span>
  </div>
</div>

<!-- Daily Totals -->
<div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
  <h2 class="font-semibold mb-4">Daily Check-ins</h2>
  <div class="flex items-end gap-4 h-40">
    <% const maxDaily = Math.max(...Object.values(dailyTotals), 1); %>
    <% dayLabels.forEach((label, d) => { %>
    <div class="flex-1 flex flex-col items-center gap-1">
      <span class="text-xs font-medium <%= dailyTotals[d] === maxDaily ? 'text-brand-600' : 'text-gray-500' %>"><%= dailyTotals[d] || 0 %></span>
      <div class="w-full rounded-t <%= dailyTotals[d] === maxDaily ? 'bg-brand-500' : 'bg-gray-200' %>"
        style="height: <%= (dailyTotals[d] || 0) / maxDaily * 100 %>%"></div>
      <span class="text-xs text-gray-400"><%= label %></span>
    </div>
    <% }) %>
  </div>
</div>

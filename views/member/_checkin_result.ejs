<div class="text-center p-8">
  <% if (type === 'checkin') { %>
  <div class="text-5xl mb-4">✓</div>
  <p class="text-2xl font-bold text-emerald-600"><%= message %></p>
  <p class="text-lg text-emerald-500 mt-1"><%= time %></p>
  <% } else { %>
  <div class="text-5xl mb-4">👋</div>
  <p class="text-2xl font-bold text-blue-600"><%= message %></p>
  <p class="text-lg text-blue-500 mt-1"><%= time %></p>
  <% } %>
  <div class="text-xs text-gray-400 mt-4">Auto-refreshing...</div>
  <script>setTimeout(() => location.reload(), 2000);</script>
</div>

<div class="max-w-2xl space-y-6">
  <div>
    <h2 class="text-xl font-bold">My Bookings</h2>
    <p class="text-sm text-gray-500 mt-0.5">Group classes and personal sessions</p>
  </div>

  <div class="card p-5">
    <h3 class="text-sm font-semibold mb-4">My Sessions</h3>
    <% if (sessions && sessions.length) { %>
      <div class="space-y-2">
        <% sessions.forEach(function(s) { %>
          <div class="flex items-center gap-3 px-4 py-3 bg-purple-50/50 rounded-xl">
            <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center shrink-0">
              <% if (s.session_date) { %>
                <span class="text-xs font-bold text-purple-600"><%= new Date(s.session_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
              <% } else { %>
                <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <% } %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium"><%= s.type || 'Session' %></div>
              <div class="text-xs text-gray-400">
                <%= s.trainers?.profiles?.full_name || 'Trainer' %>
                <% if (s.start_time) { %> &middot; <%= s.start_time %><% } %>
              </div>
            </div>
            <div class="text-right shrink-0">
              <span class="badge <%= s.status === 'confirmed' ? 'badge-success' : s.status === 'cancelled' ? 'badge-danger' : 'badge-neutral' %>">
                <%= s.status || 'scheduled' %>
              </span>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-8">
        <div class="w-12 h-12 rounded-2xl bg-gray-100 flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <p class="text-sm text-gray-500">No sessions booked</p>
        <p class="text-xs text-gray-400 mt-0.5">Your booked classes and PT sessions will appear here</p>
      </div>
    <% } %>
  </div>
</div>

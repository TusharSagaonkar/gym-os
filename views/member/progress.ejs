<div class="max-w-2xl space-y-6">
  <div>
    <h2 class="text-xl font-bold">Your Progress</h2>
    <p class="text-sm text-gray-500 mt-0.5">Track your fitness journey</p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="stat-card">
      <span class="stat-label">Total Workouts</span>
      <div class="stat-value mt-2"><%= totalWorkouts || 0 %></div>
    </div>
    <div class="stat-card">
      <span class="stat-label">Current Streak</span>
      <div class="stat-value mt-2"><%= streak || 0 %> days</div>
    </div>
    <div class="stat-card">
      <span class="stat-label">This Month</span>
      <div class="stat-value mt-2"><%= monthWorkouts || 0 %></div>
    </div>
    <div class="stat-card">
      <span class="stat-label">Hours Trained</span>
      <div class="stat-value mt-2"><%= totalHours || 0 %></div>
    </div>
  </div>

  <div class="card p-5">
    <h3 class="text-sm font-semibold mb-4">Visit History (Last 30 Days)</h3>
    <div class="flex flex-wrap gap-1.5">
      <% var days = 30; for (var i = days - 1; i >= 0; i--) {
        var d = new Date();
        d.setDate(d.getDate() - i);
        var dateStr = d.toISOString().split('T')[0];
        var visited = visitedDates && visitedDates.includes(dateStr);
      %>
        <div class="w-3.5 h-3.5 rounded-sm transition-colors <%= visited ? 'bg-brand-500' : 'bg-gray-100' %>"
             title="<%= d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %><%= visited ? ' — Visited' : '' %>"></div>
      <% } %>
    </div>
    <div class="flex items-center gap-4 mt-3 text-xs text-gray-400">
      <div class="flex items-center gap-1"><div class="w-3 h-3 rounded-sm bg-brand-500"></div> Visited</div>
      <div class="flex items-center gap-1"><div class="w-3 h-3 rounded-sm bg-gray-100"></div> Missed</div>
    </div>
  </div>

  <div class="card p-5">
    <h3 class="text-sm font-semibold mb-4">Strength Progress</h3>
    <% if (strengthData && strengthData.length) { %>
      <div class="space-y-3">
        <% strengthData.forEach(function(ex) { %>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-medium"><%= ex.name %></span>
              <span class="text-xs font-semibold text-brand-600"><%= ex.current %> kg</span>
            </div>
            <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-brand-500 to-brand-600 rounded-full transition-all duration-500" style="width:<%= Math.min((ex.current / ex.best * 100) || 0, 100) %>%"></div>
            </div>
            <div class="flex justify-between mt-1">
              <span class="text-[10px] text-gray-400">Start: <%= ex.start %> kg</span>
              <span class="text-[10px] text-gray-400">Best: <%= ex.best %> kg</span>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-8">
        <div class="w-12 h-12 rounded-2xl bg-gray-100 flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        </div>
        <p class="text-sm text-gray-500">No strength data yet</p>
        <p class="text-xs text-gray-400 mt-0.5">Start logging your workouts</p>
      </div>
    <% } %>
  </div>

  <div class="card p-5">
    <h3 class="text-sm font-semibold mb-4">Wearable Data</h3>
    <% if (wearableData) { %>
      <div class="grid grid-cols-3 gap-4">
        <div class="text-center p-3 bg-emerald-50 rounded-xl">
          <div class="text-lg font-bold text-emerald-700"><%= wearableData.avg_heart_rate || '—' %></div>
          <div class="text-[10px] text-emerald-600 font-medium mt-0.5">Avg HR</div>
        </div>
        <div class="text-center p-3 bg-orange-50 rounded-xl">
          <div class="text-lg font-bold text-orange-700"><%= wearableData.calories || '—' %></div>
          <div class="text-[10px] text-orange-600 font-medium mt-0.5">Calories</div>
        </div>
        <div class="text-center p-3 bg-blue-50 rounded-xl">
          <div class="text-lg font-bold text-blue-700"><%= wearableData.steps || '—' %></div>
          <div class="text-[10px] text-blue-600 font-medium mt-0.5">Steps</div>
        </div>
      </div>
    <% } else { %>
      <p class="text-sm text-gray-400 text-center py-4">No wearable data synced.</p>
    <% } %>
  </div>
</div>

<div class="max-w-2xl space-y-6">
  <div>
    <h2 class="text-xl font-bold">Your Progress</h2>
    <p class="text-sm text-gray-500 mt-0.5">Track your fitness journey</p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="stat-card">
      <span class="stat-label">Sessions Logged</span>
      <div class="stat-value mt-2"><%= progress.length %></div>
      <div class="text-xs text-gray-400 mt-1">last 30 days</div>
    </div>
    <div class="stat-card">
      <span class="stat-label">Latest Record</span>
      <div class="stat-value mt-2 text-sm">
        <%= latest ? new Date(latest.recorded_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : '—' %>
      </div>
      <div class="text-xs text-gray-400 mt-1">last workout</div>
    </div>
  </div>

  <div class="card p-5">
    <h3 class="text-sm font-semibold mb-4">Recent Sessions</h3>
    <% if (progress && progress.length) { %>
      <div class="space-y-2">
        <% progress.forEach(function(p) { %>
          <div class="flex items-center gap-3 px-4 py-3 bg-gray-50 rounded-xl">
            <div class="w-8 h-8 rounded-lg bg-brand-100 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium"><%= p.exercise_name || 'Workout' %></div>
              <div class="text-xs text-gray-400">
                <%= new Date(p.recorded_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
                <% if (p.sets_completed) { %> &middot; <%= p.sets_completed %> sets<% } %>
                <% if (p.weight_used) { %> &middot; <%= p.weight_used %> kg<% } %>
              </div>
            </div>
            <div class="text-right shrink-0">
              <div class="text-sm font-semibold"><%= p.weight_used ? p.weight_used + ' kg' : p.reps + ' reps' %></div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-8">
        <div class="w-12 h-12 rounded-2xl bg-gray-100 flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        </div>
        <p class="text-sm text-gray-500">No progress data yet</p>
        <p class="text-xs text-gray-400 mt-0.5">Start logging your workouts</p>
      </div>
    <% } %>
  </div>

  <% if (wearable && wearable.length) { %>
  <div class="card p-5">
    <h3 class="text-sm font-semibold mb-4">Wearable Data</h3>
    <div class="grid grid-cols-3 gap-4">
      <div class="text-center p-3 bg-emerald-50 rounded-xl">
        <div class="text-lg font-bold text-emerald-700"><%= latestWearable?.avg_heart_rate || '—' %></div>
        <div class="text-[10px] text-emerald-600 font-medium mt-0.5">Avg HR</div>
      </div>
      <div class="text-center p-3 bg-orange-50 rounded-xl">
        <div class="text-lg font-bold text-orange-700"><%= latestWearable?.calories || '—' %></div>
        <div class="text-[10px] text-orange-600 font-medium mt-0.5">Calories</div>
      </div>
      <div class="text-center p-3 bg-blue-50 rounded-xl">
        <div class="text-lg font-bold text-blue-700"><%= latestWearable?.steps || '—' %></div>
        <div class="text-[10px] text-blue-600 font-medium mt-0.5">Steps</div>
      </div>
    </div>
  </div>
  <% } %>
</div>

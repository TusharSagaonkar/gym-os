<div class="max-w-2xl space-y-6">
  <div>
    <h2 class="text-xl font-bold">Notifications</h2>
    <p class="text-sm text-gray-500 mt-0.5">Stay updated about your membership and classes</p>
  </div>

  <% if (notifications && notifications.length) { %>
    <div class="card divide-y divide-gray-50">
      <% notifications.forEach(function(n) { %>
        <div class="p-4 hover:bg-gray-50/50 transition-colors <%= n.is_read ? '' : 'bg-brand-50/30' %>">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg <%= n.type === 'urgent' ? 'bg-red-100 text-red-600' : n.type === 'reminder' ? 'bg-amber-100 text-amber-600' : 'bg-blue-100 text-blue-600' %> flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-0.5">
                <span class="text-sm font-medium"><%= n.title %></span>
                <% if (!n.is_read) { %>
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0"></span>
                <% } %>
              </div>
              <p class="text-xs text-gray-500"><%= n.message %></p>
              <span class="text-[10px] text-gray-400 mt-1.5 block"><%= new Date(n.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="card p-12 text-center">
      <div class="w-14 h-14 rounded-2xl bg-gray-100 flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
      </div>
      <h3 class="text-sm font-semibold">All clear</h3>
      <p class="text-xs text-gray-400 mt-1">No notifications yet</p>
    </div>
  <% } %>
</div>

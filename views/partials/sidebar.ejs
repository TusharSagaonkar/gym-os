<nav class="w-64 bg-gray-900 text-white flex flex-col h-full shrink-0">
  <div class="p-5 border-b border-gray-800">
    <h1 class="text-xl font-bold tracking-tight">GYM OS</h1>
    <p class="text-xs text-gray-400 mt-0.5"><%= user.role.toUpperCase() %></p>
  </div>

  <div class="flex-1 overflow-auto py-4 px-3 space-y-1">
    <% if (user.role === 'owner') { %>
      <%- include('partials/nav/owner_nav') %>
    <% } else if (user.role === 'reception') { %>
      <%- include('partials/nav/reception_nav') %>
    <% } else if (user.role === 'trainer') { %>
      <%- include('partials/nav/trainer_nav') %>
    <% } else { %>
      <%- include('partials/nav/member_nav') %>
    <% } %>
  </div>

  <div class="p-4 border-t border-gray-800 space-y-2">
    <% if (user.role === 'owner' && typeof gym !== 'undefined' && gym) { %>
    <a href="/owner/gyms" class="flex items-center gap-2 text-xs text-gray-500 hover:text-gray-300 transition-colors">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
      <%= gym.name %>
    </a>
    <% } %>
    <a href="/auth/logout" class="flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      Logout
    </a>
  </div>
</nav>

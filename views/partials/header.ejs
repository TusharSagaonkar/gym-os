<header class="h-14 bg-white border-b border-gray-200 flex items-center justify-between px-6 shrink-0">
  <h2 class="text-sm font-semibold text-gray-700"><%= title %></h2>
  <div class="flex items-center gap-3">
    <span class="text-xs text-gray-400"><%= new Date().toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
    <div class="w-8 h-8 rounded-full bg-brand-500 flex items-center justify-center text-white text-xs font-bold">
      <%= user.full_name ? user.full_name.charAt(0).toUpperCase() : '?' %>
    </div>
  </div>
</header>

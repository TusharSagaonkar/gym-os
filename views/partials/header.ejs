<header class="h-14 bg-white/80 backdrop-blur-xl border-b border-gray-100 flex items-center justify-between px-4 md:px-6 shrink-0 sticky top-0 z-10">
  <h2 class="text-sm font-semibold text-surface-700"><%= title %></h2>
  <div class="flex items-center gap-4">
    <span class="text-xs text-gray-400 hidden sm:block"><%= new Date().toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
    <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-xs font-bold shadow-lg shadow-brand-500/25 ring-2 ring-white">
      <%= user.full_name ? user.full_name.charAt(0).toUpperCase() : '?' %>
    </div>
  </div>
</header>

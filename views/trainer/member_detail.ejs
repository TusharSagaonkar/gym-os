<div>
  <a href="/trainer/members" class="text-brand-600 hover:underline text-sm mb-4 inline-block">← Back to Members</a>

  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 mb-6">
    <h1 class="text-xl font-bold"><%= member?.full_name %></h1>
    <p class="text-gray-500 text-sm"><%= member?.phone %> · <%= member?.email %></p>
  </div>

  <!-- Today's Workout -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 mb-6">
    <h2 class="font-semibold mb-3">Today's Assigned Workout</h2>
    <% if (todayWorkout?.workout_templates) { %>
      <p class="font-medium text-brand-600 mb-3"><%= todayWorkout.workout_templates.name %></p>
      <div class="space-y-2">
        <% (todayWorkout.workout_templates.exercises || []).forEach(e => { %>
        <div class="flex items-center justify-between py-2 px-3 bg-gray-50 rounded-lg">
          <span class="font-medium text-sm"><%= e.name %></span>
          <span class="text-sm text-gray-500"><%= e.sets %> × <%= e.reps %></span>
        </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-gray-400 text-sm">No workout assigned for today.</p>
      <a href="/trainer/workouts" class="text-brand-600 hover:underline text-sm mt-2 inline-block">Assign Workout →</a>
    <% } %>
  </div>

  <!-- Record Progress -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 mb-6">
    <h2 class="font-semibold mb-4">Record Progress</h2>
    <form method="POST" action="/trainer/members/<%= member?.id %>/progress" class="space-y-4">
      <div class="grid grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Weight (kg)</label>
          <input type="number" step="0.1" name="weight_kg" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Body Fat %</label>
          <input type="number" step="0.1" name="body_fat_pct" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Waist (cm)</label>
          <input type="number" step="0.1" name="waist_cm" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
        <textarea name="notes" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg"></textarea>
      </div>
      <button type="submit" class="px-4 py-2 bg-brand-600 text-white rounded-lg hover:bg-brand-700 text-sm">Record</button>
    </form>
  </div>

  <!-- Progress History -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
    <h2 class="font-semibold mb-3">Progress History</h2>
    <% if (progress.length > 0) { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-gray-600"><tr>
          <th class="text-left py-2">Date</th>
          <th class="text-left py-2">Weight</th>
          <th class="text-left py-2">Body Fat</th>
          <th class="text-left py-2">Waist</th>
          <th class="text-left py-2">Notes</th>
        </tr></thead>
        <tbody class="divide-y divide-gray-100">
          <% progress.forEach(p => { %>
          <tr>
            <td class="py-2 text-gray-500"><%= new Date(p.recorded_at).toLocaleDateString('en-IN') %></td>
            <td class="py-2"><%= p.weight_kg ? p.weight_kg + ' kg' : '—' %></td>
            <td class="py-2"><%= p.body_fat_pct ? p.body_fat_pct + '%' : '—' %></td>
            <td class="py-2"><%= p.waist_cm ? p.waist_cm + ' cm' : '—' %></td>
            <td class="py-2 text-xs text-gray-400"><%= p.notes?.substring(0, 30) || '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <p class="text-gray-400 text-sm">No progress recorded yet.</p>
    <% } %>
  </div>
</div>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-bold">Workout Templates</h1>
  <button onclick="document.getElementById('templateModal').classList.remove('hidden')"
    class="px-4 py-2 bg-brand-600 text-white text-sm rounded-lg hover:bg-brand-700">New Template</button>
</div>

<!-- Existing Templates -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
  <% templates.forEach(t => { %>
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
    <h3 class="font-semibold mb-1"><%= t.name %></h3>
    <% if (t.description) { %><p class="text-xs text-gray-400 mb-3"><%= t.description %></p><% } %>
    <div class="space-y-1 mb-4">
      <% (t.exercises || []).forEach(e => { %>
      <div class="flex justify-between text-sm py-1 px-3 bg-gray-50 rounded">
        <span><%= e.name %></span>
        <span class="text-gray-500"><%= e.sets %> × <%= e.reps %></span>
      </div>
      <% }) %>
    </div>
    <form hx-post="/trainer/workouts/assign" hx-swap="none" class="flex gap-2">
      <input type="hidden" name="template_id" value="<%= t.id %>">
      <select name="member_id" class="flex-1 px-2 py-1.5 text-xs border border-gray-300 rounded bg-white">
        <option value="">Assign to...</option>
        <% members.forEach(m => { %>
        <option value="<%= m.member_id %>"><%= m.profiles?.full_name %></option>
        <% }) %>
      </select>
      <button type="submit" class="px-3 py-1.5 bg-brand-600 text-white text-xs rounded hover:bg-brand-700">Assign</button>
    </form>
  </div>
  <% }) %>
</div>

<% if (templates.length === 0) { %>
<p class="text-gray-400 text-center py-4">No templates yet. Create your first one.</p>
<% } %>

<!-- New Template Modal -->
<div id="templateModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
  <div class="bg-white rounded-xl p-6 w-full max-w-lg shadow-xl max-h-[80vh] overflow-auto">
    <h3 class="font-semibold text-lg mb-4">New Workout Template</h3>
    <form method="POST" action="/trainer/workouts">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Template Name</label>
          <input type="text" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Push Day">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <input type="text" name="description" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Exercises</label>
          <div id="exercisesContainer" class="space-y-2">
            <div class="flex gap-2 exercise-row">
              <input type="text" name="exercise_name" placeholder="Exercise" class="flex-1 px-3 py-2 border border-gray-300 rounded text-sm">
              <input type="text" name="exercise_sets" placeholder="Sets" class="w-16 px-3 py-2 border border-gray-300 rounded text-sm">
              <input type="text" name="exercise_reps" placeholder="Reps" class="w-16 px-3 py-2 border border-gray-300 rounded text-sm">
              <button type="button" onclick="this.closest('.exercise-row').remove()" class="text-red-500 text-sm">✕</button>
            </div>
          </div>
          <button type="button" onclick="addExercise()" class="mt-2 text-sm text-brand-600 hover:underline">+ Add Exercise</button>
        </div>
      </div>
      <div class="flex gap-2 mt-6">
        <button type="button" onclick="document.getElementById('templateModal').classList.add('hidden')"
          class="flex-1 px-4 py-2 border border-gray-300 rounded-lg">Cancel</button>
        <button type="submit" class="flex-1 px-4 py-2 bg-brand-600 text-white rounded-lg hover:bg-brand-700">Save Template</button>
      </div>
    </form>
  </div>
</div>

<script>
function addExercise() {
  const container = document.getElementById('exercisesContainer');
  const row = document.createElement('div');
  row.className = 'flex gap-2 exercise-row';
  row.innerHTML = `
    <input type="text" name="exercise_name" placeholder="Exercise" class="flex-1 px-3 py-2 border border-gray-300 rounded text-sm">
    <input type="text" name="exercise_sets" placeholder="Sets" class="w-16 px-3 py-2 border border-gray-300 rounded text-sm">
    <input type="text" name="exercise_reps" placeholder="Reps" class="w-16 px-3 py-2 border border-gray-300 rounded text-sm">
    <button type="button" onclick="this.closest('.exercise-row').remove()" class="text-red-500 text-sm">✕</button>
  `;
  container.appendChild(row);
}
</script>

<h1 class="text-xl font-bold mb-6">Member Progress</h1>

<% if (members.length > 0) { %>
<div class="space-y-6">
  <% members.forEach(m => { %>
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
    <h3 class="font-semibold mb-3"><%= m.full_name %></h3>
    <% if (m.progress && m.progress.length > 0) { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-gray-600"><tr>
          <th class="text-left py-2">Date</th>
          <th class="text-left py-2">Weight</th>
          <th class="text-left py-2">Body Fat</th>
          <th class="text-left py-2">Waist</th>
        </tr></thead>
        <tbody class="divide-y divide-gray-100">
          <% m.progress.forEach(p => { %>
          <tr>
            <td class="py-2 text-gray-500"><%= new Date(p.recorded_at).toLocaleDateString('en-IN') %></td>
            <td class="py-2"><%= p.weight_kg ? p.weight_kg + ' kg' : '—' %></td>
            <td class="py-2"><%= p.body_fat_pct ? p.body_fat_pct + '%' : '—' %></td>
            <td class="py-2"><%= p.waist_cm ? p.waist_cm + ' cm' : '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <p class="text-gray-400 text-sm">No progress recorded yet.</p>
    <% } %>
  </div>
  <% }) %>
</div>
<% } else { %>
<div class="text-center py-12">
  <p class="text-gray-400 text-lg">No members assigned.</p>
</div>
<% } %>

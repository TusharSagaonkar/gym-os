<div class="min-h-screen flex">
  <div class="flex-1 flex items-center justify-center p-6">
    <div class="w-full max-w-md animate-slide-up">
      <div class="mb-8">
        <div class="w-10 h-10 rounded-2xl bg-brand-600 flex items-center justify-center text-white font-bold text-lg mb-4 shadow-lg shadow-brand-500/25">G</div>
        <h1 class="text-2xl font-bold tracking-tight">Welcome aboard!</h1>
        <p class="text-gray-500 text-sm mt-1">Tell us about your gym to get started</p>
      </div>

      <% if (error) { %>
        <div class="bg-red-50 border border-red-100 text-red-700 px-4 py-3 rounded-xl mb-6 text-sm animate-fade"><%= error %></div>
      <% } %>

      <form method="POST" action="/auth/onboarding" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Gym Name</label>
          <input type="text" name="gym_name" required autofocus
            class="input" placeholder="Iron Paradise Fitness">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Address</label>
          <input type="text" name="address" required
            class="input" placeholder="123, Main Street, Mumbai">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">City</label>
            <input type="text" name="city" required
              class="input" placeholder="Mumbai">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Phone</label>
            <input type="tel" name="phone" required
              class="input" placeholder="+91 9876543210">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Monthly Membership Price (₹)</label>
          <input type="number" name="default_price" required min="0"
            class="input" placeholder="1500">
          <p class="text-xs text-gray-400 mt-1">You can add more plans later</p>
        </div>

        <button type="submit" class="btn-primary w-full py-3 text-base">
          Create My Gym
        </button>
      </form>
    </div>
  </div>

  <div class="hidden lg:flex flex-1 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-600 via-brand-700 to-brand-950"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(255,255,255,0.08)_0%,transparent_60%)]"></div>
    <div class="relative flex items-center justify-center p-12 w-full">
      <div class="text-white max-w-md space-y-8">
        <h2 class="text-4xl font-bold tracking-tight">Your gym,<br>your rules.</h2>
        <div class="space-y-5">
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <div>
              <p class="font-medium text-sm">Member management</p>
              <p class="text-xs text-brand-200/70">Add, renew, freeze, transfer members</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
            </div>
            <div>
              <p class="font-medium text-sm">QR check-ins</p>
              <p class="text-xs text-brand-200/70">Touchless entry for members</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            </div>
            <div>
              <p class="font-medium text-sm">Analytics & insights</p>
              <p class="text-xs text-brand-200/70">Revenue, churn, occupancy in one place</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

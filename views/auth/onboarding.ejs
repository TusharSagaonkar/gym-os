<div class="min-h-screen flex items-center justify-center bg-gray-50 p-8">
  <div class="w-full max-w-md">
    <h1 class="text-2xl font-bold text-center mb-2">Complete Your Profile</h1>
    <p class="text-gray-500 text-center mb-8">Tell us a bit about yourself</p>

    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 text-sm"><%= error %></div>
    <% } %>

    <form method="POST" action="/auth/onboarding" class="space-y-5">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
        <input type="text" name="full_name" required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
        <input type="tel" name="phone" required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
        <select name="role" required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition bg-white">
          <option value="member">Member</option>
          <option value="owner">Gym Owner</option>
          <option value="reception">Reception Staff</option>
          <option value="trainer">Trainer</option>
        </select>
      </div>

      <button type="submit" class="w-full bg-brand-600 text-white py-2.5 rounded-lg font-medium hover:bg-brand-700 transition">
        Complete Setup
      </button>
    </form>
  </div>
</div>

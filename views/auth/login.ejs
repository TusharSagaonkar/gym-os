<div class="min-h-screen flex">
  <div class="flex-1 flex items-center justify-center p-6">
    <div class="w-full max-w-sm animate-slide-up">
      <div class="mb-8">
        <div class="w-10 h-10 rounded-2xl bg-brand-600 flex items-center justify-center text-white font-bold text-lg mb-4 shadow-lg shadow-brand-500/25">G</div>
        <h1 class="text-2xl font-bold tracking-tight">Welcome back</h1>
        <p class="text-gray-500 text-sm mt-1">Sign in to your gym account</p>
      </div>

      <% if (error) { %>
        <div class="bg-red-50 border border-red-100 text-red-700 px-4 py-3 rounded-xl mb-6 text-sm animate-fade"><%= error %></div>
      <% } %>

      <form method="POST" action="/auth/login" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
          <input type="email" name="email" required autofocus
            class="input" placeholder="you@example.com">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Password</label>
          <input type="password" name="password" required
            class="input" placeholder="••••••••">
        </div>

        <button type="submit" class="btn-primary w-full py-3 text-base">
          Sign In
        </button>
      </form>

      <p class="text-center text-sm text-gray-500 mt-6">
        New member?
        <a href="/auth/signup" class="text-brand-600 font-medium hover:text-brand-700 transition-colors">Join now →</a>
      </p>
    </div>
  </div>

  <div class="hidden lg:flex flex-1 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-600 via-brand-700 to-brand-950"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(255,255,255,0.1)_0%,transparent_60%)]"></div>
    <div class="relative flex items-center justify-center p-12 w-full">
      <div class="text-white max-w-md">
        <h2 class="text-4xl font-bold mb-4 tracking-tight">Run your gym,<br>not software.</h2>
        <p class="text-lg text-brand-200/80 leading-relaxed">Membership management, attendance tracking, payments, and insights — all in one place.</p>

        <div class="mt-10 space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white/10 backdrop-blur flex items-center justify-center text-sm font-medium">1</div>
            <span class="text-brand-100/80 text-sm">Member scans QR at the gate</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white/10 backdrop-blur flex items-center justify-center text-sm font-medium">2</div>
            <span class="text-brand-100/80 text-sm">Attendance recorded automatically</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white/10 backdrop-blur flex items-center justify-center text-sm font-medium">3</div>
            <span class="text-brand-100/80 text-sm">Owner sees live dashboard + analytics</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
